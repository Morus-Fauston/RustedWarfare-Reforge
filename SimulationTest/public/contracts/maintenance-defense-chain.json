{
  "schemaVersion": 1,
  "kind": "behavior-contract",
  "contractId": "public.maintenance-defense-chain.v1",
  "scope": "self-behavior",
  "scenarioIds": [
    "public.maintenance-defense-chain.v1"
  ],
  "approval": {
    "status": "tool-fixture-only",
    "source": "Fixed finite 1750 center opening, ordinary construction rates, Float production completion500, twelve tank attack; checkpoint margins independently fixed before run; no original equivalence"
  },
  "comparison": {
    "numberMode": "declared-per-field",
    "tolerances": {},
    "eventOrder": "strict-record-and-array-order"
  },
  "exclusions": [
    "original-compatibility",
    "platform-input",
    "player-visibility-long-capture",
    "performance"
  ],
  "rules": [
    {
      "ruleId": "finite-opening",
      "when": {
        "phase": "after-advance",
        "stepIndex": 0
      },
      "assertions": [
        {
          "path": "economy.preciseBalances.p1",
          "operator": "equals",
          "value": 1250
        },
        {
          "path": "units.h.alive",
          "operator": "equals",
          "value": true
        }
      ]
    },
    {
      "ruleId": "real-worker",
      "when": {
        "phase": "after-advance",
        "stepIndex": 500
      },
      "assertions": [
        {
          "path": "units.produced:p1:00000000000000000000000000000000.type",
          "operator": "equals",
          "value": "builder"
        }
      ]
    },
    {
      "ruleId": "resource-completed",
      "when": {
        "phase": "after-advance",
        "stepIndex": 2499
      },
      "assertions": [
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.constructionProgress",
          "operator": "equals",
          "value": 1
        },
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.alive",
          "operator": "equals",
          "value": true
        }
      ]
    },
    {
      "ruleId": "factory-completed",
      "when": {
        "phase": "after-advance",
        "stepIndex": 4499
      },
      "assertions": [
        {
          "path": "units.constructed:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.constructionProgress",
          "operator": "equals",
          "value": 1
        }
      ]
    },
    {
      "ruleId": "before-siege",
      "when": {
        "phase": "after-advance",
        "stepIndex": 6499
      },
      "assertions": [
        {
          "path": "units.h.alive",
          "operator": "equals",
          "value": true
        },
        {
          "path": "units.produced:p1:11111111111111111111111111111111.alive",
          "operator": "equals",
          "value": true
        },
        {
          "path": "units.produced:p1:22222222222222222222222222222222.alive",
          "operator": "equals",
          "value": true
        }
      ]
    },
    {
      "ruleId": "center-truly-dead",
      "when": {
        "phase": "after-advance",
        "stepIndex": 10499
      },
      "assertions": [
        {
          "path": "units.h.alive",
          "operator": "equals",
          "value": false
        },
        {
          "path": "units.h.health",
          "operator": "equals",
          "value": 0
        },
        {
          "path": "units.produced:p1:00000000000000000000000000000000.alive",
          "operator": "equals",
          "value": true
        },
        {
          "path": "units.constructed:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.alive",
          "operator": "equals",
          "value": true
        }
      ]
    },
    {
      "ruleId": "continued-production",
      "when": {
        "phase": "after-advance",
        "stepIndex": 13500
      },
