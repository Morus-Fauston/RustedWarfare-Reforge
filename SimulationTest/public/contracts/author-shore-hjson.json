{
  "schemaVersion": 1,
  "kind": "behavior-contract",
  "contractId": "public.author-shore.contract.v1",
  "scope": "self-behavior",
  "scenarioIds": [
    "public.author-shore.v1"
  ],
  "comparison": {
    "numberMode": "declared-per-field",
    "tolerances": {}
  },
  "approval": {
    "status": "tool-fixture-only",
    "source": "Owned author constructor and WATER shipyard with existing010 spcruiser. Existing85 reach and4 arrival; explicit eastward approach170/210 preserves east heading, then build250/210 at180 with first-step700 charge/creation180. Ready by499, existing350/.002 product queued500 births1000, legal-water move250/430 at1200. No new steering/retry/fee rule, original/performance/platform claim."
  },
  "exclusions": [
    "original-compatibility",
    "platform-input",
    "performance"
  ],
  "rules": [
    {
      "ruleId": "first-charge",
      "when": {
        "phase": "after-advance",
        "stepIndex": 180
      },
      "assertions": [
        {
          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 2300
        },
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.constructionProgress",
          "operator": "equals",
          "value": 0
        }
      ]
    },
    {
      "ruleId": "ready-factory",
      "when": {
        "phase": "after-advance",
        "stepIndex": 499
      },
      "assertions": [
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.constructionProgress",
          "operator": "equals",
          "value": 1
        },
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.health",
          "operator": "equals",
          "value": 1200
        },
        {
          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 2300
        }
      ]
    },
    {
      "ruleId": "product-charge",
      "when": {
        "phase": "after-advance",
        "stepIndex": 500
      },
      "assertions": [
        {
          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 1950
        }
      ]
    },
    {
      "ruleId": "existing-sea-birth",
      "when": {
        "phase": "after-advance",
        "stepIndex": 1000
      },
      "assertions": [
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.health",
          "operator": "equals",
          "value": 4000
        },
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.position",
          "operator": "equals",
          "value": {
            "x": 250,
            "y": 230
          }
        },
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.height",
          "operator": "equals",
          "value": 0
        }
      ]
    },
    {
      "ruleId": "arrived",
      "when": {
        "phase": "after-advance",
        "stepIndex": 1599
      },
      "assertions": [
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.tasks",
          "operator": "equals",
          "value": []
        },
        {
          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 1950
        }
      ]
    }
  ],
  "constructedUnits": [
    {
      "unitId": "constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "buildActionId": "build-shipyard",
      "builderId": "a",
      "owner": "p1",
      "typeId": "spshipyard",
      "buildingNonce": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "birthStepIndex": 180
    }
  ],
  "producedUnits": [
    {
      "unitId": "produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "productionActionId": "produce-ship",
      "producerId": "constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "owner": "p1",
      "typeId": "spcruiser",
      "unitNonce": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "birthStepIndex": 1000
    }
  ]
