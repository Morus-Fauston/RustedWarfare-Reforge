          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 3000
        }
      ]
    },
    {
      "ruleId": "surviving-ship",
      "when": {
        "phase": "after-advance",
        "stepIndex": 8199
      },
      "assertions": [
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.alive",
