{
  "schemaVersion": 1,
  "kind": "behavior-contract",
  "contractId": "public.mech-hjson-short.v1.contract",
  "scope": "self-behavior",
  "scenarioIds": [
    "public.mech-hjson-short.v1"
  ],
  "comparison": {
    "numberMode": "declared-per-field",
    "tolerances": {}
  },
  "approval": {
    "status": "tool-fixture-only",
    "source": "ENG-P008-014 finite owned mech contract: HP500, two published legs; existing Move/Stop behavior. No original compatibility claim."
  },
  "exclusions": [
    "original-compatibility",
    "platform-input",
    "performance"
  ],
  "rules": [
    {
      "ruleId": "initial-health-and-heading",
      "when": {
        "phase": "initial",
        "stepIndex": 0
      },
      "assertions": [
        {
          "path": "units.a.health",
          "operator": "equals",
          "value": 500
        },
        {
          "path": "units.a.mechPose.forwardHeading",
          "operator": "equals",
          "value": 90
        }
      ]
    },
    {
      "ruleId": "stop-clears-order",
      "when": {
        "phase": "after-advance",
        "stepIndex": 10
      },
      "assertions": [
        {
          "path": "units.a.moveTarget",
          "operator": "equals",
          "value": null
        },
        {
          "path": "units.a.health",
          "operator": "equals",
          "value": 500
        }
      ]
    }
  ]
}
