          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.position",
          "operator": "equals",
          "value": {
            "x": 270,
            "y": 155
          }
        },
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.heading",
          "operator": "equals",
          "value": 180
        },
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.health",
          "operator": "equals",
          "value": 150
        },
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.height",
          "operator": "equals",
          "value": 0
        },
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.flightPose.rotorPhase",
