      ]
    },
    {
      "ruleId": "final-paid-ledger",
      "when": {
        "phase": "after-advance",
        "stepIndex": 3199
      },
      "assertions": [
        {
          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 1300
