          "value": 150
        }
      ]
    },
    {
      "ruleId": "build-payment",
      "when": {
        "phase": "after-advance",
        "stepIndex": 0
      },
      "assertions": [
        {
          "path": "economy.balances.p1",
          "operator": "equals",
          "value": 2000
        },
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.constructionProgress",
          "operator": "equals",
          "value": 0
        }
      ]
    },
    {
      "ruleId": "factory-ready",
      "when": {
        "phase": "after-advance",
        "stepIndex": 1199
      },
      "assertions": [
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.constructionProgress",
          "operator": "equals",
          "value": 1
