      "when": {
        "phase": "after-advance",
        "stepIndex": 2260
      },
      "assertions": [
        {
          "path": "units.produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.moveTarget",
          "operator": "equals",
          "value": null
