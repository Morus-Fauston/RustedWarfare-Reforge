  "approval": {
    "status": "tool-fixture-only",
    "source": "ENG-P008-015 sealed finite self-behavior contract: builder constructs the 1000-credit native air factory; 700-credit helicopter, HP150 and 17 direct damage. The unchanged Float32 .0012 needs 834 updates, so production at1200 births at2033. Native birth270,155, heading180, height0 and phase0. No original-compatibility claim or new tolerance. Actual archive tests separately require emitted helicopter projectiles and real target damage; the final rule only fixes the unchanged paid ledger."
  },
  "exclusions": [
    "original-compatibility",
    "platform-input",
    "performance"
  ],
  "constructedUnits": [
    {
      "unitId": "constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "buildActionId": "build",
      "builderId": "worker",
      "owner": "p1",
      "typeId": "airFactory",
      "buildingNonce": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "birthStepIndex": 0
    }
  ],
  "producedUnits": [
    {
      "unitId": "produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "productionActionId": "produce",
      "producerId": "constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "owner": "p1",
      "typeId": "helicopter",
      "unitNonce": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "birthStepIndex": 2033
    }
  ],
  "rules": [
    {
      "ruleId": "initial-ledger",
      "when": {
