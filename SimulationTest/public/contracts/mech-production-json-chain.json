      "buildingNonce": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "birthStepIndex": 0
    }
  ],
  "producedUnits": [
    {
      "unitId": "produced:p1:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
