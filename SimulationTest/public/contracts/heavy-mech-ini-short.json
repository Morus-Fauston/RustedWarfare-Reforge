{
  "schemaVersion": 1,
  "kind": "behavior-contract",
  "contractId": "public.heavy-mech-ini-short.v1.contract",
  "scope": "self-behavior",
  "scenarioIds": [
    "public.heavy-mech-ini-short.v1"
  ],
  "comparison": {
    "numberMode": "declared-per-field",
    "tolerances": {}
  },
  "approval": {
    "status": "tool-fixture-only",
    "source": "ENG-P009-003/004 owned OVER_CLIFF heavy representative: HP2500, full shield500, regeneration0.08, four finite legs and normal Move/Stop. No original runtime compatibility claim."
  },
  "exclusions": [
    "original-compatibility",
    "platform-input",
    "performance"
  ],
  "rules": [
    {
      "ruleId": "initial-health-and-heading",
      "when": {
        "phase": "initial",
        "stepIndex": 0
      },
      "assertions": [
        {
          "path": "units.a.health",
          "operator": "equals",
          "value": 2500
        },
        {
          "path": "units.a.mechPose.forwardHeading",
          "operator": "equals",
          "value": 90
        },
        {
          "path": "units.a.shield.current",
          "operator": "equals",
          "value": 500
        },
        {
          "path": "units.a.shield.maximum",
          "operator": "equals",
          "value": 500
        },
        {
          "path": "units.a.shield.displayDamage",
          "operator": "equals",
          "value": 0
        }
      ]
    },
    {
      "ruleId": "stop-clears-order",
      "when": {
        "phase": "after-advance",
        "stepIndex": 10
      },
      "assertions": [
        {
          "path": "units.a.moveTarget",
          "operator": "equals",
          "value": null
        },
        {
          "path": "units.a.health",
          "operator": "equals",
          "value": 2500
        }
      ]
    }
  ]
}
