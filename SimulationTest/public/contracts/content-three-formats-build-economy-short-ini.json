        },
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.constructionProgress",
          "operator": "equals",
          "value": 0
        }
      ]
    },
    {
      "ruleId": "refund",
      "when": {
        "phase": "after-advance",
        "stepIndex": 1
      },
      "assertions": [
        {
          "path": "economy.preciseBalances.p1",
          "operator": "equals",
          "value": 4300
        },
        {
          "path": "upgrades.e",
          "operator": "equals",
          "value": []
        }
      ]
    },
    {
      "ruleId": "native-center-income",
      "when": {
        "phase": "after-advance",
        "stepIndex": 9
      },
      "assertions": [
