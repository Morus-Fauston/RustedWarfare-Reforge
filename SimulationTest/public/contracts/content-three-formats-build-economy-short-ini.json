      "when": {
        "phase": "after-advance",
        "stepIndex": 49
      },
      "assertions": [
        {
          "path": "economy.preciseBalances.p1",
          "operator": "equals",
          "value": 4330.5
        },
        {
          "path": "units.constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.owner",
          "operator": "equals",
          "value": "p1"
        }
      ]
    }
  ],
  "constructedUnits": [
    {
      "unitId": "constructed:p1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "buildActionId": "build",
      "builderId": "w",
      "owner": "p1",
