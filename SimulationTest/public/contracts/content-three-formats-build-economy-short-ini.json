{
  "schemaVersion": 1,
  "kind": "behavior-contract",
  "contractId": "public.content-three-formats-build-economy-short-ini.v1.contract",
  "scope": "self-behavior",
  "scenarioIds": [
    "public.content-three-formats-build-economy-short-ini.v1"
  ],
  "comparison": {
    "numberMode": "declared-per-field",
    "tolerances": {}
  },
  "approval": {
    "status": "tool-fixture-only",
