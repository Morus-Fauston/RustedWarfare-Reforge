          "path": "economy.preciseBalances.p1",
          "operator": "equals",
          "value": 4304.5
        }
      ]
    },
    {
      "ruleId": "combined-income",
      "when": {
        "phase": "after-advance",
        "stepIndex": 39
      },
      "assertions": [
        {
          "path": "economy.preciseBalances.p1",
          "operator": "equals",
          "value": 4326
        }
      ]
