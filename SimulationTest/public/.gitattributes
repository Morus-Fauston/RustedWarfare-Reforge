# Content identities are byte-based across Windows and Linux checkouts.
*.json text eol=lf
*.hjson text eol=lf
*.ini text eol=lf
*.properties text eol=lf
*.tmx text eol=lf
*.png binary

# These authored fixture families carry exact byte identities in scenarios,
# package declarations and evidence. Preserve their reviewed bytes on every OS;
# source/scenario/contract text outside inputs keeps the LF rules above.
inputs/three-format-tanks/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
inputs/three-format-production/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
