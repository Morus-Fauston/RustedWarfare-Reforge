{
  "schemaVersion": 1,
  "scenarioId": "platform-maintenance-basics",
  "rules": [
    {
      "intentId": "choose-extractor",
      "actionType": "SelectAction",
      "unitId": "extractor",
      "accepted": true,
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "extractorT1"
      },
      "assertions": [
        {
          "path": "units.extractor.typeId",
          "operator": "equals",
          "value": "extractorT1"
        }
      ]
    },
    {
      "intentId": "upgrade-economic",
      "actionType": "UpgradeAction",
      "unitId": "extractor",
      "accepted": true,
      "actionFields": {
        "upgradeId": "upgrade_t2"
      },
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "extractorT1"
      },
      "assertions": [
        {
          "path": "balance",
          "operator": "deltaEquals",
          "value": -1400
        },
        {
          "path": "upgradeQueues.extractor.items",
          "operator": "equals",
          "value": [
            {
              "actionKey": "upgrade_t2",
              "targetTypeId": "extractorT2",
              "progress": 0
            }
          ]
        }
      ]
    },
    {
      "intentId": "cancel-economic",
      "actionType": "CancelUpgradeAction",
      "unitId": "extractor",
      "accepted": true,
      "actionFields": {
        "upgradeId": "upgrade_t2"
      },
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "extractorT1"
      },
      "assertions": [
        {
          "path": "balance",
          "operator": "deltaEquals",
          "value": 1400
        },
        {
          "path": "upgradeQueues.extractor.items",
          "operator": "equals",
          "value": []
        }
      ]
    },
    {
      "intentId": "choose-worker",
      "actionType": "SelectAction",
      "unitId": "worker",
      "accepted": true,
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "builder"
      },
      "assertions": [
        {
          "path": "units.worker.typeId",
          "operator": "equals",
          "value": "builder"
        }
      ]
    },
    {
      "intentId": "reclaim-extractor",
      "actionType": "ReclaimUnitAction",
      "unitId": "worker",
      "accepted": true,
      "actionFields": {
        "targetUnitId": "extractor"
      },
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "builder"
      },
      "assertions": [
        {
          "path": "balance",
          "operator": "deltaEquals",
          "value": 0
        },
        {
          "path": "units.worker.tasks",
          "operator": "equals",
          "value": [
            {
              "kind": "reclaim",
              "target": null,
              "targetUnitId": "extractor",
              "automaticRepair": false,
              "extraWorkRange": 0.0
            }
          ]
        },
        {
          "path": "units.extractor.typeId",
          "operator": "equals",
          "value": "extractorT1"
        }
      ]
    }
  ]
}
