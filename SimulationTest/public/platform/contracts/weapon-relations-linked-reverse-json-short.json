      },
      "assertions": [
        {
          "path": "units.a.maxHealth",
          "operator": "equals",
          "value": 100000
        }
      ]
    },
    {
      "intentId": "relations",
      "actionType": "AttackAction",
      "unitId": "a",
      "accepted": true,
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "linked_tank"
      },
      "targetIdentity": {
        "ownerPlayerId": "p2",
        "typeId": "linked_tank"
      },
      "actionFields": {
