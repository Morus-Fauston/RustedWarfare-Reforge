        "samples": 1,
        "assertions": [
          {
            "path": "weapons.a.leader.targetUnitId",
            "operator": "equals",
            "value": "c"
          },
          {
            "path": "weapons.a.follower.targetUnitId",
            "operator": "equals",
            "value": "b"
          },
          {
            "path": "weapons.a.follower.cooldown",
            "operator": "equals",
            "value": 8974
          },
          {
            "path": "units.b.health",
            "operator": "lessThan",
            "value": 100000
          },
          {
            "path": "units.c.health",
            "operator": "lessThan",
            "value": 100000
          }
        ]
      },
      "weaponBirths": [
        {
          "unitId": "a",
          "weaponName": "leader",
          "targetUnitId": "c",
          "minimumOccurrences": 4
        },
        {
          "unitId": "a",
          "weaponName": "follower",
          "targetUnitId": "b",
          "minimumOccurrences": 4
        }
      ],
      "assertions": [
        {
          "path": "units.a.attackTargetId",
          "operator": "equals",
          "value": "b"
        }
      ]
    },
    {
      "intentId": "stop",
      "actionType": "StopAction",
      "unitId": "a",
      "accepted": true,
      "unitIdentity": {
        "ownerPlayerId": "p1",
        "typeId": "linked_tank"
      },
      "assertions": [
        {
          "path": "weapons.a.leader.targetUnitId",
          "operator": "equals",
          "value": null
