{
  "schemaVersion": 1,
  "scenarioId": "resource-sound-ogg",
  "rules": [
    {
      "intentId": "choose-tank",
      "actionType": "SelectAction",
      "unitId": "a",
      "accepted": true,
      "assertions": [
        {
          "path": "units.a.typeId",
          "operator": "equals",
          "value": "c_tank"
        }
      ]
    },
    {
      "intentId": "attack-enemy",
      "actionType": "AttackAction",
      "unitId": "a",
      "accepted": true,
      "actionFields": {
        "targetUnitId": "b"
      },
      "assertions": [
        {
          "path": "units.a.attackTargetId",
          "operator": "equals",
          "value": "b"
        }
      ]
    }
  ],
  "resourceImages": {
    "packOrder": [
      "owned:sound-ogg",
      "reforge:base"
    ],
    "resources": {
      "owned:sound-icon": {
        "providerId": "owned:sound-ogg",
        "frameWidth": 32,
        "frameHeight": 32,
        "totalFrames": 1,
        "pixelWidth": 64,
        "pixelHeight": 64,
        "bound": false
      }
    }
  },
  "resourceSounds": {
    "eventId": "reforge:events/tank-fire",
    "resourceId": "owned:sounds/shot",
    "providerId": "owned:sound-ogg",
    "minimumRequests": 1
  }
}
